# Copy to deploy/.env and replace every value. Never commit the real file.
POSTGRES_PASSWORD=change-me-long-random
FENRIR_SECRET_KEY=change-me-64-hex-chars   # openssl rand -hex 32
FENRIR_PUBLIC_URL=https://fenrir.example.com
FENRIR_DOMAIN=fenrir.example.com          # used by the optional Caddy HTTPS override
FENRIR_ADMIN_EMAIL=admin@example.com
FENRIR_ADMIN_PASSWORD=change-me-at-least-12-chars
FENRIR_OPEN_ENROLLMENT=false
FENRIR_FEED_TOKEN=

# Master key for the credential vault and stored integration secrets (Microsoft 365, SNMP, backup APIs).
# openssl rand -base64 32   - keep a copy somewhere safe: without it stored secrets cannot be read.
# Required by Docker Compose. Local development can still use a derived key.
FENRIR_VAULT_KEY=
# Old vault keys still accepted for reading during rotation (comma-separated). Run "Rotate vault key" afterwards.
FENRIR_VAULT_OLD_KEYS=
# Set false only AFTER rotating all legacy derived-key values and checking failed=0.
FENRIR_VAULT_ALLOW_DERIVED_LEGACY=true

# PSA email (optional). Without SMTP, notification emails are only logged.
FENRIR_SMTP_HOST=
FENRIR_SMTP_PORT=587
FENRIR_SMTP_USER=
FENRIR_SMTP_PASSWORD=
FENRIR_SMTP_FROM=support@example.com
# Inbound mailbox for email-to-ticket (optional; or use the webhook URL from Service settings).
FENRIR_IMAP_HOST=
FENRIR_IMAP_USER=
FENRIR_IMAP_PASSWORD=
FENRIR_IMAP_FOLDER=INBOX

# Windows user-mode installers are compiled in the Docker build. Production requires
# deploy/signing/codesign.pfx and codesign.password; lab uses docker-compose.lab.yml.
FENRIR_BUILD_PROFILE=production
# Linux/macOS release signing key. Relative paths resolve against deploy/.
# Generate this once, keep it for later builds and back it up offline.
FENRIR_RELEASE_KEY=./signing/release-ed25519.pem
# Optional monotonic release number; auto-update.sh calculates one when it builds.
FENRIR_RELEASE_SEQ=

# Telemetry: every event is kept FENRIR_TELEMETRY_RETENTION_DAYS; routine activity (process, image-load, network, script scans,
# DNS, file, registry) only FENRIR_ROUTINE_RETENTION_DAYS unless a detection matched it. Past the per-device cap,
# routine events are still checked by every detection rule but only matches are stored (0 = no cap).
FENRIR_TELEMETRY_RETENTION_DAYS=90
FENRIR_ROUTINE_RETENTION_DAYS=30
FENRIR_ROUTINE_EVENTS_PER_DEVICE_MINUTE=600

# Staff must use MFA (change it in Settings > Platform > Security). Break glass for a console network list that locks
# every administrator out: set FENRIR_IGNORE_CONSOLE_ALLOWLIST=true, restart, fix the list, then remove it.
FENRIR_REQUIRE_MFA=true
FENRIR_IGNORE_CONSOLE_ALLOWLIST=false
# Library scripts run only in a version a second person reviewed (also in Settings > Platform > Security).
FENRIR_SCRIPT_REVIEW=false
