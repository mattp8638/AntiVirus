# Copy to deploy/.env and replace every value. Never commit the real file.
POSTGRES_PASSWORD=change-me-long-random
FENRIR_SECRET_KEY=change-me-64-hex-chars   # openssl rand -hex 32
FENRIR_PUBLIC_URL=https://fenrir.example.com
FENRIR_ADMIN_EMAIL=admin@example.com
FENRIR_ADMIN_PASSWORD=change-me-at-least-12-chars
FENRIR_OPEN_ENROLLMENT=true
FENRIR_FEED_TOKEN=

# Master key for the credential vault and stored integration secrets (Microsoft 365, SNMP, backup APIs).
# openssl rand -base64 32   - keep a copy somewhere safe: without it stored secrets cannot be read.
# Required by Docker Compose. Local development can still use a derived key.
FENRIR_VAULT_KEY=
# Old vault keys still accepted for reading during rotation (comma-separated). Run "Rotate vault key" afterwards.
FENRIR_VAULT_OLD_KEYS=
# Set false only AFTER rotating all legacy derived-key values and checking failed=0.
FENRIR_VAULT_ALLOW_DERIVED_LEGACY=true

# PSA email (optional). Without SMTP, notification emails are only logged.
FENRIR_SMTP_HOST=
FENRIR_SMTP_PORT=587
FENRIR_SMTP_USER=
FENRIR_SMTP_PASSWORD=
FENRIR_SMTP_FROM=support@example.com
# Inbound mailbox for email-to-ticket (optional; or use the webhook URL from Service settings).
FENRIR_IMAP_HOST=
FENRIR_IMAP_USER=
FENRIR_IMAP_PASSWORD=
FENRIR_IMAP_FOLDER=INBOX

# Optional Windows enrollment downloads: first put a signed FenrirSetup.exe in deploy/releases/
# Pin the signing certificate's SHA-1 thumbprint (40 hexadecimal characters); the
# downloadable PowerShell wrapper also checks the release SHA-256 hash.


# The Windows development installer compiles automatically as part of Docker builds.
# Every download is a unique, tenant-bound EXE; no staging or signing config.
